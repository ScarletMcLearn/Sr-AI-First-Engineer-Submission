{
  "name": "l10-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.22.0",
  "engines": {
    "node": "24.22.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ./openapi.json -o ./src/lib/api/schema.d.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "demo": "node demo/run.mjs presentation",
    "demo:validate": "node demo/run.mjs validation",
    "demo:stack": "node demo/stack.mjs",
    "demo:session": "node demo/session.mjs",
    "demo:scene": "node demo/ctl.mjs scene",
    "demo:status": "node demo/ctl.mjs status",
    "demo:reset": "node demo/ctl.mjs reset",
    "demo:stop": "node demo/ctl.mjs stop",
    "test:stack": "node --test demo/stack-lib.test.mjs demo/session-state.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.108.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.76.0",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
